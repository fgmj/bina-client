<?xml version="1.0" encoding="utf-8"?>
<!-- IDs usados por SettingsController são preservados (environmentChoice, chooseProduction, chooseLocal,
     localAddress, localPort, deviceName, checkUpdates, updateFeedback, settingsFeedback). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_server"
            android:textAppearance="@style/TextAppearance.Bina.Section" />

        <RadioGroup
            android:id="@+id/environmentChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/chooseProduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_production"
                android:textAppearance="@style/TextAppearance.Bina.Body" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/chooseLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_local"
                android:textAppearance="@style/TextAppearance.Bina.Body" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/localFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="@string/settings_local_address"
                app:helperText="@string/settings_local_address_help">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/localAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:minHeight="48dp"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/settings_local_port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/localPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5"
                    android:minHeight="48dp"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/settingsFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="Testar não altera o ambiente ativo. Salvar ativa o ambiente e cadastra o nome."
            android:textAppearance="@style/TextAppearance.Bina.Caption" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_device"
            android:textAppearance="@style/TextAppearance.Bina.Section" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/settings_device_name"
            app:counterEnabled="false"
            app:helperText="@string/settings_device_name_help">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/deviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="255"
                android:minHeight="48dp"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_location"
            android:textAppearance="@style/TextAppearance.Bina.Section" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/locationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/settings_location_switch"
            android:textAppearance="@style/TextAppearance.Bina.Body" />

        <TextView
            android:id="@+id/locationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/settings_location_help"
            android:textAppearance="@style/TextAppearance.Bina.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/locationBackground"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/settings_location_background"
            android:visibility="gone"
            app:icon="@drawable/ic_location" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_updates"
            android:textAppearance="@style/TextAppearance.Bina.Section" />

        <TextView
            android:id="@+id/updateFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:text="Consulta o ambiente ativo salvo. Salve antes de verificar outro ambiente."
            android:textAppearance="@style/TextAppearance.Bina.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkUpdates"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/settings_check_updates" />
    </LinearLayout>
</ScrollView>
